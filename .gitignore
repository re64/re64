node_modules/
dist/
*.log
.DS_Store
public/app.js
public/app.js.map

# Transient session state: Yjs updates awaiting a flatten.
*.re64.session

# Project databases; the exported .re64 is the tracked artefact
*.re64db
*.re64db-wal
*.re64db-shm

# Agent request transcripts: experiment output, regenerated per run
*.mcp.jsonl

# Experiment working directories: regenerated by setup.sh
experiments/*/run/
# setup.sh copies the target binary into whatever run directory it is given,
# and a numbered one is tracked — so the image would be committed beside the
# copy in assets/ that it came from.
experiments/*/run*/*.d64
# ...but keep the transcripts a finding was drawn from
!experiments/*/runs/

# Third-party test material is fetched, not built
3party/**/*.bin
