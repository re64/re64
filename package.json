{
  "name": "re64",
  "version": "0.1.0",
  "description": "A collaborative C64 disassembler",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "re64": "./dist/cli/index.js",
    "re64-server": "./dist/server/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./client": "./dist/client/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "clean": "rm -rf dist",
    "build:ui": "esbuild src/ui/main.ts --bundle --format=esm --outfile=public/app.js --sourcemap",
    "dev:ui": "esbuild src/ui/main.ts --bundle --format=esm --outfile=public/app.js --sourcemap --watch",
    "serve": "node dist/server/index.js"
  },
  "keywords": [
    "c64",
    "commodore",
    "disassembler",
    "6502",
    "retro"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@shoelace-style/shoelace": "^2.20.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.0.0",
    "lib0": "^0.2.117",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
