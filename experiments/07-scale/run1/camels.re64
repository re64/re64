        { "id": "rgn_menyq4", "start": "$5870", "end": "$5906", "kind": "text", "name": "srcResidueSpriteSet", "comment": "Leftover assembler source, BASIC line format. See the comment at $5870.", "encoding": "petscii" },
        { "id": "rgn_7vm4d0", "start": "$5870", "end": "$5900", "kind": "data", "name": "devSourceResidue" },
