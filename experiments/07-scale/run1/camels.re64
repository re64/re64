        { "id": "rgn_2ofd5l", "start": "$8488", "end": "$84B0", "kind": "text", "encoding": "screen" },
        { "id": "rgn_hed97h", "start": "$8550", "end": "$8578", "kind": "text", "encoding": "screen" },
        { "id": "rgn_oz8co1", "start": "$8618", "end": "$8640", "kind": "text", "encoding": "screen" },
        { "id": "rgn_iyngnn", "start": "$86E0", "end": "$8708", "kind": "text", "encoding": "screen" },
        { "id": "rgn_xp6vd8", "start": "$87A8", "end": "$87D0", "kind": "text", "encoding": "screen" },
        { "id": "rgn_17k03s", "start": "$87D0", "end": "$87FE", "kind": "data", "name": "padBeforeCode", "comment": "32 zero bytes then 14 x $EA. The wave table ends at $87CF and code begins at $87FE; this is the gap. The $EA run is NOP filler rather than data anyone reads — nothing references it and it decodes to fourteen NOPs falling into the routine at $87FE." },
        { "id": "rgn_7bdotc", "start": "$87D0", "end": "$87F0", "kind": "data", "name": "zoneTablePad" },
        { "id": "rgn_4ts5le", "start": "$87F0", "end": "$87FE", "kind": "code", "name": "nopFiller" },
        { "id": "rgn_m73twx", "start": "$8834", "end": "$8839", "kind": "code", "name": "deadReadCharAt", "comment": "JSR ScreenAddrFromRow / LDA ($48),Y - the body of a read-character-at routine whose entry point is gone. The RTS after it at $8839 is live: PrintCharAt branches there when the column is off screen." },
        { "id": "rgn_mksov4", "start": "$88FE", "end": "$8903", "kind": "code", "name": "deadRasterReload", "comment": "Five orphaned bytes, A9 60 8D 12 D0 = LDA #$60 / STA $D012. Nothing branches here: the JMP at $88FB goes over it and the music player continues at $8903. Setting the raster back to $60 is what the phase dispatcher at $8BC9 now does, so this is the old version left in place when that moved. Declared code so it reads as what it is rather than as five stray bytes." },
        { "id": "rgn_vzw3fw", "start": "$898C", "end": "$89CD", "kind": "data", "name": "noteFreqLo" },
        { "id": "rgn_gnbgbc", "start": "$89CD", "end": "$8A0E", "kind": "data", "name": "noteFreqHi" },
        { "id": "rgn_j459dn", "start": "$8A0E", "end": "$8A39", "kind": "data", "name": "starSeedTables", "comment": "Three 12-byte tables read 1-based: column at $8A0E, row at $8A1A, colour at $8A26, then titleFlashColours at $8A32." },
        { "id": "rgn_g1yyav", "start": "$8DF4", "end": "$8E74", "kind": "data", "name": "terrainProfiles", "comment": "Two hill profiles for the scrolling landscape: six frames at $8DF4, ten at $8E24, six bytes of screen codes each plus two unused. See the comment at $8DF4." },
        { "id": "rgn_1y0io5", "start": "$90E4", "end": "$90F8", "kind": "text", "name": "txtOfTheMutantCamels", "encoding": "petscii" },
        { "id": "rgn_dj7kd4", "start": "$90F8", "end": "$9120", "kind": "text", "name": "txtStatusLineTemplate", "encoding": "petscii" },
        { "id": "rgn_dtm5sl", "start": "$9120", "end": "$9148", "kind": "text", "name": "txtNeutroniumLineTemplate", "encoding": "petscii" },
        { "id": "rgn_jghn3c", "start": "$9148", "end": "$9170", "kind": "data", "name": "panelRow1Colours" },
        { "id": "rgn_udsob4", "start": "$9565", "end": "$9569", "kind": "data", "name": "landingSquashShapes" },
        { "id": "rgn_s18uar", "start": "$96F7", "end": "$96FC", "kind": "data", "name": "cheatKeySequence" },
        { "id": "rgn_jbx4n7", "start": "$9933", "end": "$9939", "kind": "jumptable", "name": "moveHandlerTable", "comment": "Three movement handlers as ordinary lo/hi pairs. sub_993A doubles the index and reads $9933,Y for the low byte and $9934,Y for the high one.\n\n  entry 0 -> $9939, which is the $60 IMMEDIATELY AFTER this table. A byte doubling as an RTS: movement type 0 does nothing.\n  entry 1 -> $994F  MoveObjectLinear\n  entry 2 -> $99C0  MoveObjectAccelerating\n\nThe index is objMoveType,X AND #$7F, so bit 7 of that byte is free for something else — and the player uses it for facing ($9492 and $94A3 write $00 and $80 there).\n\n$994C is JMP ($0002): the walk cannot follow a vector, which is why 103 instructions below it were invisible. $02/$03 is the print-column scratch pair being borrowed as a jump vector. Marking the two targets recovered them all." },
        { "id": "rgn_fa2hcf", "start": "$9C4A", "end": "$9C51", "kind": "data", "name": "neutroniumColourRamp" },
        { "id": "rgn_6zgh3s", "start": "$9D21", "end": "$9D29", "kind": "data", "name": "messageFlashColours", "comment": "Eight colours - 00 06 02 04 05 03 07 01 - cycled into messageLineColour ($D990) by $9D13, indexed by $4F counting down. Entry 0 is black, so the message fades to invisible on the last step before $9D29 clears the line." },
        { "id": "rgn_4cplpd", "start": "$9FEF", "end": "$A000", "kind": "data", "name": "tailFiller", "comment": "Seventeen bytes between the last routine and $A000, where BASIC ROM takes over. 90 00 FF 10 00 00 00 FF 00 80 00 18 43 42 4F 4F 16 - the tail reads CBOO in PETSCII, so this is most likely residue from the build machine like the assembler source at $5870, not data. Nothing references it and no code reaches it. I cannot tell what it was." },
        { "id": "rgn_noai6m", "start": "$A000", "end": "$C000", "kind": "data", "name": "underBasicRom", "comment": "8192 bytes of zero in the image, and never read as RAM.\n\nNothing in this program writes $00 or $01, so the 6510 port stays at its power-on $37 and BASIC ROM is banked in across $A000-$BFFF. Every read of this range — NextRandom at $8D21, and TitleColourAndSoundStep at $50BD — gets ROM, not these bytes.\n\nDeclared data so it stops showing as unexplained. It is explained: it is a window onto ROM that this project cannot model, because a layer supplying an address always wins and nothing has loaded a KERNAL or BASIC image." },
        { "id": "rgn_85c3wm", "start": "$C0CB", "end": "$C100", "kind": "data", "name": "loaderPad" },
        { "id": "rgn_2x81jw", "start": "$C100", "end": "$C112", "kind": "text", "name": "highScoreFilenames", "comment": "Two overlapping filenames: $C100 is @:ATTACK MUTANT.HI (18 chars, used by SAVE), $C102 is ATTACK MUTANT.HI (16 chars, used by LOAD). The load name is the save name with the @: prefix skipped - one string serving both calls.", "encoding": "petscii" },
        { "id": "rgn_rew0f0", "start": "$C112", "end": "$C11F", "kind": "data", "name": "highScoreNamePad", "comment": "Ten $FF bytes then three zeros, immediately after the two filenames. Filler to the end of the loaded image at $C11F; nothing reads it." }
      ],
