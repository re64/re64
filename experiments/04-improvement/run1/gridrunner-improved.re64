  "decoders": [
    {
      "id": "dec_1znxc3",
      "name": "gridrunnerCharset",
      "source": "\n// Gridrunner ships its own 64-glyph character set at $8E00 (copied to $2000 and\n// selected by the $18 written to $D018). No built-in encoding applies, so every\n// string in this program is unreadable without this map. It was read off the\n// glyph bitmaps: render $8E00 as char:8 and the letters are legible.\n//\n// Only the letters the game's own text needs exist: A B D E F G H I J L M N O\n// P R S T U V Y. There is no C, K, Q, W, X or Z anywhere in the set.\n// $30 is a single glyph doing duty as both the letter O and the digit 0, which\n// is why \"PRESS FIRE TO BEGIN\" and a seven-digit score share one byte value.\n// $3C and $3D are the two halves of one copyright symbol.\nconst HIGH = \" GRUIDNEABFHJMPSO123456789TV()L|\";\nconst LOW = {\n  0x00: \"+\", 0x01: \"[\", 0x02: \"^\",\n  0x03: \"/\", 0x04: \"/\", 0x05: \"/\", 0x06: \"/\",\n  0x07: \"^\", 0x08: \"!\", 0x09: \"!\", 0x0a: \"v\",\n  0x0b: \">\", 0x0c: \"<\",\n  0x0d: \".\", 0x0e: \"o\", 0x0f: \"O\", 0x10: \"0\", 0x11: \"@\", 0x12: \"*\",\n  0x13: \"D\", 0x14: \"D\", 0x15: \"D\",\n  0x16: \"'\", 0x17: \"'\", 0x18: \"'\",\n  0x19: \"P\", 0x1a: \"L\", 0x1b: \"Y\", 0x1c: \"Y\", 0x1d: \"H\", 0x1e: \"I\", 0x1f: \"?\",\n};\nlet line = \"\";\nfor (const b of bytes) {\n  if (b === 0x3c) { line += \"(c\"; continue; }\n  if (b >= 0x20 && b <= 0x3f) { line += HIGH[b - 0x20]; continue; }\n  line += LOW[b] !== undefined ? LOW[b] : \"?\";\n}\nconst width = (params && params.width) || 40;\nconst out = [];\nfor (let i = 0; i < line.length; i += width) out.push(line.slice(i, i + width));\nreturn { kind: \"text\", lines: out.length ? out : [\"\"] };\n"
    },
    {
      "id": "dec_j1k7ti",
      "name": "petsciiWithDuplicateLetterRange",
      "source": "// PETSCII including the DUPLICATE LETTER RANGE. In the unshifted character set\n// codes $C1-$DA render the same A-Z as $41-$5A; re64's built-in petscii encoding\n// maps that upper range through a graphics table instead, so the standard C64\n// cartridge signature comes out as punctuation rather than as CBM80.\nconst glyph = (b) => {\n  if (b >= 0xc1 && b <= 0xda) return String.fromCharCode(b - 0xc0 + 64);\n  if (b >= 0x41 && b <= 0x5a) return String.fromCharCode(b);\n  if (b >= 0x20 && b <= 0x40) return String.fromCharCode(b);\n  if (b >= 0x5b && b <= 0x5f) return String.fromCharCode(b);\n  return '.';\n};\nlet out = '';\nfor (const b of bytes) out += glyph(b);\nreturn { kind: 'text', lines: [out] };"
    }
  ],
