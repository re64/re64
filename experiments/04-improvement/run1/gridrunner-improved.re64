    {
      "id": "lay_kdhw6h",
      "type": "prg",
      "path": "gridrunner.prg",
      "noAutoEntry": true,
      "regions": [
        {
          "id": "rgn_1jmk1o",
          "start": "$8000",
          "end": "$8004",
          "kind": "jumptable",
          "name": "initJumpTable"
        },
        {
          "id": "rgn_49myeh",
          "start": "$8004",
          "end": "$8009",
          "kind": "text",
          "name": "cartridgeSignature",
          "comment": "$C3 $C2 $CD $38 $30 = \"CBM80\" in PETSCII, where codes $C1-$DA duplicate the letters at $41-$5A. This is the autostart signature a C64 looks for at $8004 when it finds a cartridge at $8000; together with the cold-start vector at $8000 and the NMI vector at $8002 it is what makes this an 8K cartridge image rather than a loadable program. The binary the reference disassembly was made from has these five bytes zeroed, which is what a cartridge-to-PRG conversion does so the machine will not autostart it.",
          "view": "snippet:dec_j1k7ti"
        },
        {
          "id": "rgn_ibp594",
          "start": "$8009",
          "end": "$8011",
          "kind": "data",
          "name": "unusedAfterCartridgeHeader",
          "comment": "$00 $8F $9D $00 $21 $CA $D0 $F1 - nothing reads these and no control flow reaches them. $CA $D0 $F1 would decode as DEX / BNE -15, which is the shape of a delay loop, so this looks like the tail of something that was overwritten by the cartridge header rather than deliberate padding."
        },
        {
          "id": "rgn_08ymdx",
          "start": "$8014",
          "end": "$8015",
          "kind": "code",
          "name": "filler8014"
        },
        {
          "id": "rgn_xz7zne",
          "start": "$801D",
          "end": "$8020",
          "kind": "code",
          "name": "filler801D"
        },
        {
          "id": "rgn_q5wati",
          "start": "$802B",
          "end": "$8030",
          "kind": "code",
          "name": "filler802B"
        },
        {
          "id": "rgn_adzd4d",
          "start": "$803F",
          "end": "$8040",
          "kind": "code",
          "name": "filler803F"
        },
        {
          "id": "rgn_k9pgm6",
          "start": "$805F",
          "end": "$8060",
          "kind": "code",
          "name": "filler805F"
        },
        {
          "id": "rgn_6u63z2",
          "start": "$8080",
          "end": "$80A0",
          "kind": "text",
          "name": "copyrightLine",
          "comment": "32 bytes read as copyrightLine-1,X for X=$20..1 at $80D4 and written to screen $0592 (row 10, col 2) in colour 7. Through the game charset: \"(c) 1982 HES  PRESS FIRE TO BEGIN\". HES was the US publisher; Gridrunner is 1982, which is one of the reasons the reference file header calling this game Matrix (1983) is wrong.",
          "view": "snippet:dec_1znxc3"
        },
        {
          "id": "rgn_dkps9y",
          "start": "$80FE",
          "end": "$8100",
          "kind": "code",
          "name": "filler80FE"
        },
        {
          "id": "rgn_vklmre",
          "start": "$8162",
          "end": "$8163",
          "kind": "code",
          "name": "unreachableRts8162",
          "comment": "An RTS that follows an unconditional JMP: InitializeGame leaves through JMP ShowBannerThenTitle and never returns."
        },
        {
          "id": "rgn_4cqwge",
          "start": "$837B",
          "end": "$8380",
          "kind": "code",
          "name": "filler837B"
        },
        {
          "id": "rgn_6auofk",
          "start": "$839C",
          "end": "$83A0",
          "kind": "code",
          "name": "filler839C"
        },
        {
          "id": "rgn_6bd0yt",
          "start": "$83F0",
          "end": "$8400",
          "kind": "code",
          "name": "unreachableSpareMainLoopEntry",
          "comment": "Ten NOPs, a JMP EnterMainGameLoop, and three more NOPs. Nothing reaches any of it; it is a second way into the main loop that no longer has a caller."
        },
        {
          "id": "rgn_ou7d3y",
          "start": "$83FD",
          "end": "$8400",
          "kind": "code",
          "name": "filler83FD"
        },
        {
          "id": "rgn_ft3bpd",
          "start": "$871F",
          "end": "$8728",
          "kind": "data",
          "name": "podDecaySequence"
        },
        {
          "id": "rgn_4icvat",
          "start": "$87D8",
          "end": "$87D9",
          "kind": "code",
          "name": "unreachableRts87D8",
          "comment": "Unreachable: the instruction above is an unconditional JMP to CheckIfBulletCollidedWithDroid."
        },
        {
          "id": "rgn_174tj8",
          "start": "$881E",
          "end": "$8820",
          "kind": "data",
          "name": "filler881E",
          "comment": "Two $EA bytes between the code and the banner table. The reference groups the second of them with screenHeaderText as a base-1 dummy entry, which is the same bytes described differently."
        },
        {
          "id": "rgn_ujf3p1",
          "start": "$8820",
          "end": "$8848",
          "kind": "text",
          "name": "screenHeaderText",
          "comment": "Screen row 0, copied by DrawGameBanner as $881F,X for X=$28..1. Through the game charset: \"GRIDRUNNER  PL 0000000  HI 0000000  <ship>  4\". $19+$1A are one proportional pair reading PL and $1D+$1E another reading HI; $8847 = $34 is the initial lives digit at column 39, which StartLevel re-writes and ClearScreenAndRestartLevel decrements. The reference groups that byte with the colour table instead, where it is not a colour.",
          "view": "snippet:dec_1znxc3"
        },
        {
          "id": "rgn_iouxkw",
          "start": "$8848",
          "end": "$8870",
          "kind": "data",
          "name": "screenHeaderColors"
        },
        {
          "id": "rgn_a3niki",
          "start": "$8984",
          "end": "$8990",
          "kind": "code",
          "name": "unreachableDroidFragments",
          "comment": "Twelve bytes nothing references and no control flow reaches: LDX #$01 / INC currentDroidCharacter / RTS, then LDX currentDroidIndex / INX / CPX noOfDroidSquadsCurrentLevel / RTS, then a NOP. Two abandoned routine tails left in place - development leftovers, not data."
        },
        {
          "id": "rgn_c9ofyy",
          "start": "$8989",
          "end": "$8990",
          "kind": "code",
          "name": "unreachableDroidCountCheck",
          "comment": "The second of the two abandoned tails here. Needs its own declaration because the RTS at $8988 ends the first one, so no walk continues into it."
        },
        {
          "id": "rgn_eumn6p",
          "start": "$898F",
          "end": "$8990",
          "kind": "data",
          "name": "filler898F"
        },
        {
          "id": "rgn_bog0w8",
          "start": "$8AD4",
          "end": "$8ADE",
          "kind": "code",
          "name": "unreachableShipCollisionCheck",
          "comment": "JSR GetCharacterAtCurrentXYPos / CMP #$07 / BEQ +3 / JMP WriteCurrentCharacterToCurrentXYPos. The reference asks \"Is this reached?\" over these bytes. It is not: find_references reports nothing inbound and no instruction falls into $8AD4, which is preceded by a JMP. It is a superseded copy of the check DrawDroids now makes through CheckForShipCollision."
        },
        {
          "id": "rgn_f1xs08",
          "start": "$8AE7",
          "end": "$8AE9",
          "kind": "code",
          "name": "unreachableRts8AE7"
        },
        {
          "id": "rgn_4yyuw5",
          "start": "$8AE8",
          "end": "$8AE9",
          "kind": "data",
          "name": "filler8AE8"
        },
        {
          "id": "rgn_ssy0m2",
          "start": "$8AF1",
          "end": "$8AF8",
          "kind": "code",
          "name": "unreachableCollisionTail",
          "comment": "CMP #$20 / BEQ $8AF0 / JMP ResetStackAndKillShip - the rest of a longer CheckForShipCollision that now returns at $8AF0. Unreachable: the RTS above it is unconditional."
        },
        {
          "id": "rgn_tbmtx9",
          "start": "$8B5D",
          "end": "$8B60",
          "kind": "code",
          "name": "unreachableExplosionDelay",
          "comment": "DEX / BNE $8B59. $8B58 loads #$14 into A and then JMPs away instead of running this loop, so the count is loaded and never used and these two instructions never execute. The reference lists the same dead pair."
        },
        {
          "id": "rgn_oqeb3f",
          "start": "$8BC0",
          "end": "$8BD1",
          "kind": "data",
          "name": "explosionControlArrays"
        },
        {
          "id": "rgn_jcifwy",
          "start": "$8BD1",
          "end": "$8BD2",
          "kind": "code",
          "name": "filler8BD1"
        },
        {
          "id": "rgn_kik0mr",
          "start": "$8CB5",
          "end": "$8CD5",
          "kind": "data",
          "name": "noOfDroidSquadsForLevel"
        },
        {
          "id": "rgn_h1mmki",
          "start": "$8CD5",
          "end": "$8CF5",
          "kind": "data",
          "name": "sizeOfDroidSquadsForLevels",
          "comment": "32 entries, indexed 1..32 by selectedLevel from base $8CD4 (LDA $8CD4,X at $8C93). The seeded region ran one byte long and stole $8CF4, which is entry 32 of THIS table and simultaneously the base-1 of the next one."
        },
        {
          "id": "rgn_ef4ctn",
          "start": "$8CF5",
          "end": "$8D16",
          "kind": "data",
          "name": "laserFrameRateForLevel",
          "comment": "32 entries $8CF5-$8D14, indexed 1..32 from base $8CF4 (LDA $8CF4,X at $8C98), plus one $EA filler byte at $8D15. The seeded region started at $8CF6 and ran to $8D18, which swallowed the LDA #$30 at $8D16 that begins PlayNewLevelSounds - that is the $8D16 warning."
        },
        {
          "id": "rgn_lrt6mz",
          "start": "$8C51",
          "end": "$8C63",
          "kind": "text",
          "name": "txtBattleStations",
          "view": "snippet:dec_1znxc3"
        },
        {
          "id": "rgn_kxcnyv",
          "start": "$8C63",
          "end": "$8C75",
          "kind": "text",
          "name": "txtEnterGridArea",
          "view": "snippet:dec_1znxc3"
        },
        {
          "id": "rgn_r0lmcu",
          "start": "$8DCB",
          "end": "$8DD0",
          "kind": "code",
          "name": "unreachableBranchIntoInstruction",
          "comment": "BCS $8D5A, then three NOPs. $8DCB follows an unconditional JMP and nothing branches here, so it never executes - but its target is the OPERAND byte of STA selectedLevel at $8D59, not an instruction start. Declaring it code makes re64 decode $8D5A as a second stream, which is the reading this byte would have if the branch were ever taken."
        },
        {
          "id": "rgn_7bfu6l",
          "start": "$8DD0",
          "end": "$8DE1",
          "kind": "data",
          "name": "paddingBeforeText"
        },
        {
          "id": "rgn_twxguz",
          "start": "$8DE1",
          "end": "$8DEF",
          "kind": "text",
          "name": "txtByJeffMinter",
          "view": "snippet:dec_1znxc3"
        },
        {
          "id": "rgn_n3smyf",
          "start": "$8DEF",
          "end": "$8DF1",
          "kind": "data",
          "name": "fillerBetweenTitleStrings",
          "comment": "$20 then $EA: not part of either string. The copy loops read $8DE1-$8DEE and $8DF1-$8DFE."
        },
        {
          "id": "rgn_r0a886",
          "start": "$8DF1",
          "end": "$8DFF",
          "kind": "text",
          "name": "txtEnterLevel",
          "view": "snippet:dec_1znxc3"
        },
        {
          "id": "rgn_d4iofu",
          "start": "$8DFF",
          "end": "$8E00",
          "kind": "data",
          "name": "filler8DFF",
          "comment": "One $20 byte the title-screen copy loop never reaches; the loop stops at $8DFE."
        },
        {
          "id": "rgn_rxbj2n",
          "start": "$8E00",
          "end": "$9000",
          "kind": "bitmap",
          "name": "characterSetData",
          "comment": "The game furnishes its own 64-character set, copied to $2000 by LoadCharacterSetData and selected by the $18 written to $D018 in InitializeGame. $00-$1F are game objects (grid cell, zappers, ship, bullet, bomb, laser frames, pod decay stages, droid frames, explosion debris) and $20-$3F are the text glyphs. Rendering it is the only way to read any string in this program: no built-in encoding applies.",
          "view": "char:8"
        }
      ],
