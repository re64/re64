  "types": [
    {
      "id": "typ_kmfi89",
      "name": "HighScoreEntry",
      "size": 52,
      "fields": {
        "0": { "name": "rank", "type": "char(1)", "description": "PETSCII/ASCII digit 1-4, the table position", "id": "fld_e7xk8q" },
        "3": { "name": "score", "type": "char(7)", "description": "seven PETSCII/ASCII digit characters, all zero in the shipped default table", "id": "fld_bcgppg" },
        "14": { "name": "message", "type": "char(38)", "description": "flavour text, space-padded to the field width. Stored as plain PETSCII/ASCII (0x41-0x5A for letters), unlike the screen-code HUD strings elsewhere in this file (dat_511B etc, which use 0x01-0x1A for letters) -- corrected after an initial char(38,screen) declaration rendered this field as line/card-suit graphics instead of text.", "id": "fld_i5bl72" }
      }
    },
    {
      "id": "typ_o2g7mb",
      "name": "PlayerSlot",
      "size": 128,
      "fields": {
        "0": { "name": "status_line", "type": "bytes(40)", "description": "copy of a screen row worth of char codes, AND-$3F masked; source and exact meaning vary by call site, not always readable text -- see the msg_* claims for what does get copied through here", "id": "fld_9x3agi" },
        "48": { "name": "saved_zp58", "type": "u8", "description": "saved from zero page $58 by sub_539B when this slot screen state is stashed; restored into $58 by sub_5359", "id": "fld_n4xwfe" },
        "49": { "name": "saved_zp50", "type": "u8", "description": "saved from zero page $50, same mechanism as saved_zp58", "id": "fld_5o62ky" },
        "50": { "name": "saved_zp54", "type": "u8", "description": "saved from zero page $54, same mechanism as saved_zp58", "id": "fld_n06yat" }
      }
    },
    {
      "id": "typ_fk29ac",
      "name": "HighScoreEntryLive",
      "size": 52,
      "fields": {
        "0": { "name": "rank", "type": "char(1,screen)", "description": "screen-code digit 1-4", "id": "fld_3nqwyx" },
        "3": { "name": "score", "type": "char(7,screen)", "description": "seven screen-code digit characters", "id": "fld_ceq6rv" },
        "14": { "name": "message", "type": "char(38,screen)", "description": "same field as HighScoreEntry.message, but this copy is screen-code (0x01-0x1A) rather than PETSCII/ASCII (0x41-0x5A) -- it is written by seed_highscore_buffer ($545C) via AND #$3F over the PETSCII source at highscore_entry_1..4, and is what gets POKEd straight to the screen and LOAD/SAVEd as ATTACK MUTANT.HI", "id": "fld_vj7zk7" }
      }
    },
    {
      "id": "typ_wpo47p",
      "name": "MusicStep",
      "size": 2,
      "fields": {
        "0": { "name": "duration", "type": "u8", "description": "Frames/ticks to hold the note; small values (1-14 seen). Not confirmed against a tempo constant.", "id": "fld_gzxx1a" },
        "1": { "name": "note", "type": "u8", "description": "Index into sid_note_freq_lo/hi ($898C/$89CD) via the sequencer at loc_88F7. $F0 marks the end of a phrase/track (checked with CMP #$F0 at $8928).", "id": "fld_15j4v0" }
      }
    },
