  "targets": [
    { "id": "tgt_8p75tn", "name": "loader", "layers": [{"id":"lnk_qjjaad","layer":"lay_5xtrg9"}], "entryPoints": ["$080D"], "order": 1, "description": "The file as the disk loads it, still crunched." },
    { "id": "tgt_9kwvu8", "name": "runtime", "layers": [{"id":"lnk_0rzo58","layer":"lay_0qqeu3"}], "entryPoints": ["$C065","$8A3C"], "order": 2, "description": "The image the loader expands into: the 2021 build as it runs. This is what every experiment read, and the default view." },
    { "id": "tgt_s23bgk", "name": "machine", "layers": [{"id":"lnk_vbcfgy","layer":"lay_ghrx9l"},{"id":"lnk_mq6ss6","layer":"lay_deyq88"},{"id":"lnk_j3cteq","layer":"lay_fg504y"},{"id":"lnk_tys6mq","layer":"lay_0qqeu3"}], "entryPoints": ["$C065"], "order": 3, "description": "The runtime image plus the ROMs, as a 6510 sees memory at power-on. Scenarios run here, because a view with no ROMs vectors into zeros." },
    { "id": "tgt_xwgpft", "name": "standalone", "layers": [{"id":"lnk_ofpulz","layer":"lay_ayyup1"}], "entryPoints": ["$87F0"], "order": 4, "description": "The 1984 release, which stops at $A002 and has the collision gate the 2021 build bypasses. Byte-identical to the binary the mwenge listing ships beside — though not to that listing, which documents the patch." },
    { "id": "tgt_y9pb1a", "name": "patched", "layers": [{"id":"lnk_swaocr","layer":"lay_ayyup1"},{"id":"lnk_ewqh51","layer":"lay_cydhqi"},{"id":"lnk_ix5fyg","layer":"lay_1bmw1q"},{"id":"lnk_h375q7","layer":"lay_x0besk"},{"id":"lnk_f931oo","layer":"lay_v9a409"},{"id":"lnk_wvwsfq","layer":"lay_9p8581"},{"id":"lnk_7izns5","layer":"lay_3hfrey"},{"id":"lnk_4hkef9","layer":"lay_vm98cn"},{"id":"lnk_mt0xco","layer":"lay_m5zdbw"},{"id":"lnk_dyop32","layer":"lay_0liys4"},{"id":"lnk_8n2b1x","layer":"lay_jbzavm"},{"id":"lnk_6qrq5m","layer":"lay_ia4s8u"}], "entryPoints": ["$C065"], "order": 5, "description": "The 1984 build with the May 2021 collision fix laid over it as eleven named layers. Reproduces `runtime` over the whole of the code, which is what makes the patch a fact rather than a story." }
  ],
