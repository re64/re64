  "scenarios": [
    {
      "id": "scn_d3a5pk",
      "name": "decrunch",
      "description": "Run the loader until it hands control on, and keep what it expanded. The only way to see this build at all: the disk holds a crunched file, and reading it statically stops after a few dozen instructions.",
      "steps": [
        { "kind": "start", "at": 2061, "id": "stp_5waqd3" },
        { "kind": "run", "leaves": true, "maxInstructions": 20000000, "id": "stp_kuctb0" },
        { "kind": "capture", "what": "ram", "from": 2049, "to": 49439, "name": "runtime.prg", "id": "stp_qkaxsr" }
      ]
    },
    {
      "id": "scn_szyhoc",
      "name": "boots",
      "description": "Run the game from its entry point on a machine with ROMs. Proves the machine target is a machine: with no ROM linked, $FFFE reads as zero and the first interrupt after CLI takes the program to $0000.",
      "steps": [
        { "kind": "start", "at": 49253, "id": "stp_1dd9yz" },
        { "kind": "run", "frames": 40, "id": "stp_s0va68" }
      ]
    }
  ],
