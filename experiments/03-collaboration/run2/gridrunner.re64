  "decoders": [
    { "id": "dec_i24r3l", "name": "gridrunnerText", "source": "const T=\" GRUIDNEABFHJMPSO123456789TV\";\nconst map=c=>{\n  if(c>=0x20&&c<=0x3B) return T[c-0x20];\n  if(c===0x1B||c===0x1C) return \"Y\";\n  if(c===0x3C) return \"@\";\n  if(c===0x3D) return \"(\";\n  if(c===0x3E) return \"L\";\n  if(c===0x3F) return \"|\";\n  if(c===0x00) return \"+\";\n  if(c===0xEA) return \"~\";\n  return \".\";\n};\nconst lines=[]; let cur=\"\";\nfor(const b of bytes){ cur+=map(b); if(cur.length>=32){lines.push(cur);cur=\"\";} }\nif(cur) lines.push(cur);\nreturn {kind:\"text\",lines};\n" }
  ]
}
