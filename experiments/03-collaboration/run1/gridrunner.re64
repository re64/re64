  "decoders": [
    { "id": "dec_3g1jgm", "name": "Gridrunner custom font text", "source": "const MAP = {\n 0x1b:\"Y\",0x1c:\"Y\",0x1d:\"h\",0x1e:\"r\",0x20:\" \",\n 0x21:\"G\",0x22:\"R\",0x23:\"U\",0x24:\"I\",0x25:\"D\",0x26:\"N\",0x27:\"E\",0x28:\"A\",\n 0x29:\"B\",0x2a:\"F\",0x2b:\"H\",0x2c:\"J\",0x2d:\"M\",0x2e:\"P\",0x2f:\"S\",\n 0x30:\"O\",0x31:\"1\",0x32:\"2\",0x33:\"3\",0x34:\"4\",0x35:\"5\",0x36:\"6\",0x37:\"7\",\n 0x38:\"8\",0x39:\"9\",0x3a:\"T\",0x3b:\"V\",0x3c:\"(\",0x3d:\")\",0x3e:\"L\",0x3f:\"|\"\n};\nconst per = (params && params.width) || 32;\nconst lines = [];\nfor (let i = 0; i < bytes.length; i += per) {\n  let s = \"\";\n  for (let j = i; j < Math.min(i + per, bytes.length); j++) {\n    const b = bytes[j];\n    s += (MAP[b] !== undefined) ? MAP[b] : (b === 0x30 ? \"0\" : \"{\" + b.toString(16).padStart(2,\"0\") + \"}\");\n  }\n  lines.push(s);\n}\nreturn { kind: \"text\", lines };\n" },
    { "id": "dec_faoggb", "name": "Character cells as a picture (8 bytes per glyph)", "source": "\n// Render 8-byte character cells as a picture.\n// params.cols  how many glyphs per row (default 8)\n// params.codes optional list of glyph numbers to lay out instead of all of them\nconst cols = params.cols || 8;\nconst n = Math.floor(bytes.length / 8);\nconst codes = params.codes || Array.from({length: n}, (_, i) => i);\nconst rows = [];\nfor (let i = 0; i < codes.length; i += cols) rows.push(codes.slice(i, i + cols));\nconst W = cols * 8, H = rows.length * 9;\nconst px = new Array(W * H).fill(0);\nfor (let r = 0; r < rows.length; r++)\n  for (let c = 0; c < rows[r].length; c++) {\n    const g = rows[r][c];\n    for (let y = 0; y < 8; y++) {\n      const b = bytes[g * 8 + y] || 0;\n      for (let x = 0; x < 8; x++) px[(r * 9 + y) * W + c * 8 + x] = (b >> (7 - x)) & 1;\n    }\n  }\nreturn { kind: \"bitmap\", width: W, height: H, pixels: px, palette: [\"#000000\", \"#ffffff\"] };\n" }
  ],
