  ],
  "types": [
    {
      "id": "typ_kmf3i0",
      "name": "HighScoreEntry",
      "size": 52,
      "fields": {
        "0": { "name": "rank", "type": "char(1)", "description": "PETSCII/ASCII digit 1-4, the table position", "id": "fld_huun1o" },
        "3": { "name": "score", "type": "char(7)", "description": "seven PETSCII/ASCII digit characters, all zero in the shipped default table", "id": "fld_6vnqmm" },
        "14": { "name": "message", "type": "char(38)", "description": "flavour text, space-padded to the field width. Stored as plain PETSCII/ASCII (0x41-0x5A for letters), unlike the screen-code HUD strings elsewhere in this file (dat_511B etc, which use 0x01-0x1A for letters) -- corrected after an initial char(38,screen) declaration rendered this field as line/card-suit graphics instead of text.", "id": "fld_01zt37" }
      }
    },
    {
      "id": "typ_e0f8id",
      "name": "PlayerSlot",
      "size": 128,
      "fields": {
        "0": { "name": "status_line", "type": "bytes(40)", "description": "copy of a screen row worth of char codes, AND-$3F masked; source and exact meaning vary by call site, not always readable text -- see the msg_* claims for what does get copied through here", "id": "fld_jughw6" },
        "48": { "name": "saved_zp58", "type": "u8", "description": "saved from zero page $58 by sub_539B when this slot screen state is stashed; restored into $58 by sub_5359", "id": "fld_te7z2o" },
        "49": { "name": "saved_zp50", "type": "u8", "description": "saved from zero page $50, same mechanism as saved_zp58", "id": "fld_8tlpt6" },
        "50": { "name": "saved_zp54", "type": "u8", "description": "saved from zero page $54, same mechanism as saved_zp58", "id": "fld_b63rpa" }
      }
    },
    {
      "id": "typ_c1rxmv",
      "name": "HighScoreEntryLive",
      "size": 52,
      "fields": {
        "0": { "name": "rank", "type": "char(1,screen)", "description": "screen-code digit 1-4", "id": "fld_s0w74t" },
        "3": { "name": "score", "type": "char(7,screen)", "description": "seven screen-code digit characters", "id": "fld_c8ah61" },
        "14": { "name": "message", "type": "char(38,screen)", "description": "same field as HighScoreEntry.message, but this copy is screen-code (0x01-0x1A) rather than PETSCII/ASCII (0x41-0x5A) -- it is written by seed_highscore_buffer ($545C) via AND #$3F over the PETSCII source at highscore_entry_1..4, and is what gets POKEd straight to the screen and LOAD/SAVEd as ATTACK MUTANT.HI", "id": "fld_ee82mx" }
      }
    },
    {
      "id": "typ_3ze0up",
      "name": "MusicStep",
      "size": 2,
      "fields": {
        "0": { "name": "duration", "type": "u8", "description": "Frames/ticks to hold the note; small values (1-14 seen). Not confirmed against a tempo constant.", "id": "fld_2asgbp" },
        "1": { "name": "note", "type": "u8", "description": "Index into sid_note_freq_lo/hi ($898C/$89CD) via the sequencer at loc_88F7. $F0 marks the end of a phrase/track (checked with CMP #$F0 at $8928).", "id": "fld_9l0sfa" }
      }
    }
  ],
  "scenarios": [
    {
      "id": "scn_lrqp6y",
      "name": "decrunch",
      "description": "Run the loader until it hands control on, and keep what it expanded.",
      "steps": [
        { "kind": "start", "at": 2061, "id": "stp_bdqso7" },
        { "kind": "run", "leaves": true, "maxInstructions": 20000000, "id": "stp_atxh1i" },
        { "kind": "capture", "what": "ram", "from": 2049, "to": 49439, "name": "runtime.prg", "id": "stp_jc26zd" }
      ]
    },
    {
      "id": "scn_mr1qhe",
      "name": "boot-title",
      "description": "Cold-start the runtime image at $8A3C and watch the first few seconds.",
      "steps": [
        { "kind": "start", "at": 35388, "id": "stp_k2qnfk" },
        { "kind": "run", "frames": 200, "id": "stp_deq1tr" },
        { "kind": "capture", "what": "screen", "name": "boot200.screen", "id": "stp_u4so9z" },
        { "kind": "run", "frames": 300, "id": "stp_5s3xn5" },
        { "kind": "capture", "what": "screen", "name": "boot500.screen", "id": "stp_6u111j" }
      ]
    },
    {
      "id": "scn_yjxvc8",
      "name": "diag1",
      "description": "Diagnostic: where does it end up, and what is in screen RAM.",
      "steps": [
        { "kind": "start", "at": 35388, "id": "stp_ev9rus" },
        { "kind": "run", "frames": 200, "id": "stp_0kd6rn" },
        { "kind": "capture", "what": "ram", "from": 1024, "to": 2047, "name": "diag_screenram.bin", "id": "stp_zyau9v" },
        { "kind": "capture", "what": "trace", "name": "diag_trace.txt", "id": "stp_r3tyth" },
        { "kind": "run", "frames": 2, "id": "stp_ciwftr" },
        { "kind": "capture", "what": "trace", "name": "diag_trace2.txt", "id": "stp_iewfp8" }
      ]
    },
    {
      "id": "scn_rjvzkk",
      "name": "play-from-loader",
      "description": "Run the packed file as the disk loads it, let it decrunch and start, and photograph the result.",
      "steps": [
        { "kind": "start", "at": 2061, "id": "stp_7s7wx3" },
        { "kind": "run", "frames": 250, "id": "stp_ttnd67" },
        { "kind": "capture", "what": "screen", "name": "ldr250.screen", "id": "stp_5m69lg" },
        { "kind": "run", "frames": 250, "id": "stp_cvfh5i" },
        { "kind": "capture", "what": "screen", "name": "ldr500.screen", "id": "stp_76bux3" },
        { "kind": "run", "frames": 500, "id": "stp_llxygr" },
        { "kind": "capture", "what": "screen", "name": "ldr1000.screen", "id": "stp_ntnc75" }
      ]
    },
    {
      "id": "scn_sytgiv",
      "name": "boot2",
      "description": "Boot at $8A3C with the KERNAL linked.",
      "steps": [
        { "kind": "start", "at": 35388, "id": "stp_94s38e" },
        { "kind": "run", "frames": 60, "id": "stp_alyfsy" },
        { "kind": "capture", "what": "trace", "name": "b2a.txt", "id": "stp_el91cw" },
        { "kind": "run", "frames": 240, "id": "stp_p6nqoq" },
        { "kind": "capture", "what": "screen", "name": "b2.screen", "id": "stp_hogy3s" },
        { "kind": "capture", "what": "trace", "name": "b2b.txt", "id": "stp_hvuhxs" }
      ]
    },
    {
      "id": "scn_ksm9gv",
      "name": "probe-pc",
      "description": "Where does the CPU get to before it falls off?",
      "steps": [
        { "kind": "start", "at": 35388, "id": "stp_za3cd8" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 50, "id": "stp_ta2cjj" },
        { "kind": "capture", "what": "trace", "name": "p50.txt", "id": "stp_mk92b9" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 200, "id": "stp_xupc40" },
        { "kind": "capture", "what": "trace", "name": "p200.txt", "id": "stp_e6wplt" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 1000, "id": "stp_l6idhe" },
        { "kind": "capture", "what": "trace", "name": "p1000.txt", "id": "stp_9vbzd3" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 5000, "id": "stp_ned54r" },
        { "kind": "capture", "what": "trace", "name": "p5000.txt", "id": "stp_yec46c" }
      ]
    },
    {
      "id": "scn_8auhw2",
      "name": "probe-pc2",
      "steps": [
        { "kind": "start", "at": 35388, "id": "stp_43vb3p" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 300, "id": "stp_sfcz1h" },
        { "kind": "capture", "what": "trace", "name": "q300.txt", "id": "stp_cd79nd" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 100, "id": "stp_g3jaqo" },
        { "kind": "capture", "what": "trace", "name": "q400.txt", "id": "stp_huygu4" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 100, "id": "stp_mtgm7d" },
        { "kind": "capture", "what": "trace", "name": "q500.txt", "id": "stp_lqegm5" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 50, "id": "stp_yrb9gg" },
        { "kind": "capture", "what": "trace", "name": "q550.txt", "id": "stp_h9u3i1" },
        { "kind": "run", "cycles": 100000000, "maxInstructions": 50, "id": "stp_zx6glq" },
